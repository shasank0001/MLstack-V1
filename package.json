{
  "name": "mlstack",
  "version": "0.5.0",
  "private": true,
  "description": "A local Linux ML experiment workbench built with Pi",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "mlstack": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/cli.js",
    "demo": "npm run build && node dist/demo.js",
    "test:agent": "npm run build && node dist/scripts/agent-eval.js",
    "test:workflows": "npm run build && node dist/scripts/agent-eval.js --workflows",
    "test:skills": "npm run build && node dist/scripts/skill-eval.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shasank0001/MLstack-V1.git"
  },
  "bugs": {
    "url": "https://github.com/shasank0001/MLstack-V1/issues"
  },
  "homepage": "https://github.com/shasank0001/MLstack-V1#readme",
  "license": "UNLICENSED",
  "overrides": {
    "undici": "8.12.2",
    "zod": "4.6.6"
  }
}
